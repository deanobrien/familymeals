{
  "expo": {
    "name": "Family Recipes",
    "slug": "family-recipes",
    "scheme": "familyrecipes",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Family Recipes to photograph recipes and receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Family Recipes to pick recipe and receipt photos."
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Family Recipes to use your location to pick the store you are in, and to save where a store is. Your position is only compared on this phone.",
          "locationAlwaysAndWhenInUsePermission": "Allow Family Recipes to notice when you arrive at a store you saved, even when the app is closed. Your position is only compared on this phone.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Family Recipes to listen when you add items to your shopping list by voice.",
          "speechRecognitionPermission": "Allow Family Recipes to turn your speech into shopping list items.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Family Recipes to look at whether you are free in the evening, so the planner can pick quick meals on busy days. Only busy or free is used; event titles are never read or sent."
        }
      ]
    ],
    "android": {
      "package": "uk.ac.northumbria.familyrecipes",
      "versionCode": 3,
      "allowBackup": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "family-recipes-dean-cph4g5cuh9fmhhfy.ukwest-01.azurewebsites.net",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "family-recipes-dean-cph4g5cuh9fmhhfy.ukwest-01.azurewebsites.net",
              "pathPrefix": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.READ_CALENDAR"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ac0b4769-5441-42ec-b2ca-c9ff09f79393"
      }
    },
    "owner": "suremedia111",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ac0b4769-5441-42ec-b2ca-c9ff09f79393",
      "fallbackToCacheTimeout": 0
    }
  }
}
