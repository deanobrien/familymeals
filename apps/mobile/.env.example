# Only public (anon) values. NEVER put service-role or AI keys here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Server endpoint that runs recipe extraction (L13). Optional until wired.
EXPO_PUBLIC_API_BASE_URL=
# Set to "supabase" once a SupabaseDataSource exists; default is the mock.
EXPO_PUBLIC_DATA_SOURCE=mock
