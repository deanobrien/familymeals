# Only public (anon) values. NEVER put service-role or AI keys here.
# When EXPO_PUBLIC_SUPABASE_URL (and the anon key) are set the app uses the Supabase data source; otherwise the mock.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web app that runs recipe extraction: the app POSTs to ${EXPO_PUBLIC_API_BASE_URL}/api/extract with the
# Supabase access token as a Bearer header. Use the machine's LAN IP for a device (not localhost).
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:3100
