{
  "name": "family-recipes",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@fr/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "mobile:export": "pnpm --filter @fr/mobile exec expo export --platform android",
    "e2e:install": "pnpm --filter @fr/e2e exec playwright install chromium",
    "test:e2e": "pnpm --filter @fr/e2e e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supabase": "^2.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.6.7",
      "typescript": "~5.7.2",
      "@types/node": "^22.10.2",
      "vitest": "^2.1.9",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "@types/react": "^19.0.2",
      "@types/react-dom": "^19.0.2"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "supabase"
    ]
  }
}
