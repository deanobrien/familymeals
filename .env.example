# Copy to .env.local (never commit real values). Everything here is SERVER-ONLY:
# do not prefix with NEXT_PUBLIC_ and never import into client components.

# Supabase (local: values printed by `pnpm exec supabase start`; cloud: project settings, London eu-west-2)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Privileged. Server-side only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider: mock (default, no key needed, deterministic) or anthropic
AI_PROVIDER=mock
# Required only when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Auth (L11): safe to expose; enable real auth when both are set (otherwise dev-only local mock auth; refused in production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: origin used in emailed / invite links
NEXT_PUBLIC_SITE_URL=

# Production / Azure App Service (see docs/DEPLOY-APP-SERVICE.md). Production startup refuses mock auth, mock AI,
# the in-memory backend and a missing APP_SECRET (D150).
DATA_BACKEND=
# >= 16 chars; encrypts stored AI provider keys. SECRET.
APP_SECRET=
# First test deploy only: allow AI settings + uploads as local files until they move to Supabase.
ALLOW_LOCAL_FILE_STORE=
# Where those files go in production (default /home/data on App Service).
APP_DATA_DIR=

# Recipe discovery (X1, D170). Unset = TheMealDB's free test key "1" (development / educational use only).
# A supporter key is required before a public release. SECRET, server-only.
THEMEALDB_API_KEY=
# Set to "mock" to use offline sample recipes (no network). e2e sets this itself.
RECIPE_SOURCE=

# Packaged products (barcode lookup, X2): mock (default, offline fixtures) or off (live Open Food Facts)
PRODUCT_PROVIDER=mock
# Required when PRODUCT_PROVIDER=off: contact for the Open Food Facts User-Agent, e.g. an ops mailbox
OFF_CONTACT=
